{
  "expo": {
    "name": "غيث",
    "slug": "ghaith",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ghaith.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "غيث بيحوّل كلامك لنص عشان يفهم المهام.",
        "NSMicrophoneUsageDescription": "غيث بيحتاج المايك عشان تحكي معه وتعطيه مهامك بالصوت."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F5FB",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ghaith.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "غيث",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F6F5FB",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C5CE7"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "غيث بيحتاج المايك عشان تحكي معه وتعطيه مهامك بالصوت.",
          "speechRecognitionPermission": "غيث بيحوّل كلامك لنص عشان يفهم المهام.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "scheme": "ghaith",
    "experiments": {
      "baseUrl": "/Ghaith"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/cb4b83f3-6424-4ca0-989b-45f6b786f569"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb4b83f3-6424-4ca0-989b-45f6b786f569"
      }
    },
    "owner": "odaihatem"
  }
}
